{
  "name": "pr-reviewer",
  "version": "1.0.0",
  "private": true,
  "description": "A PR triage bot for maintainers drowning in contributor pull requests.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "bin"
  ],
  "bin": {
    "pr-reviewer": "./bin/pr-reviewer.js"
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "schema": "ts-json-schema-generator --path src/types.ts --type PullRequestContext --tsconfig tsconfig.json --no-type-check -o schema/pull-request-context.schema.json",
    "fixtures:record": "node scripts/record-fixtures.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wagmiiii/pr-reviewer.git"
  },
  "keywords": [],
  "bugs": {
    "url": "https://github.com/wagmiiii/pr-reviewer/issues"
  },
  "homepage": "https://github.com/wagmiiii/pr-reviewer#readme",
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.1.2",
    "ajv": "^8.20.0",
    "eslint": "^10.8.0",
    "prettier": "^3.9.6",
    "ts-json-schema-generator": "^2.9.0",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@octokit/plugin-retry": "^8.1.1",
    "@octokit/plugin-throttling": "^11.0.5",
    "js-yaml": "^5.2.3",
    "octokit": "^5.0.5"
  }
}
