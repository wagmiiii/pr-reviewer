{
  "name": "pr-reviewer",
  "version": "1.0.0",
  "private": true,
  "description": "A PR triage bot for maintainers drowning in contributor pull requests.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wagmiiii/pr-reviewer.git"
  },
  "keywords": [],
  "bugs": {
    "url": "https://github.com/wagmiiii/pr-reviewer/issues"
  },
  "homepage": "https://github.com/wagmiiii/pr-reviewer#readme",
  "devDependencies": {
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "prettier": "^3.9.6",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=24"
  }
}
